# =============================================================================
# room-management-api - environment variables (80-room flat rental platform)
# Validated at boot by src/core/config/env.schema.ts (the app refuses to start and prints a
# VARIABLE | CURRENT VALUE | PROBLEM table when something is missing or malformed).
#
# Copy to .env for local development, or map into a Kubernetes ConfigMap / Secret.
# Variables marked [SECRET] must come from a Secret store, never a ConfigMap.
# Load order (first wins): real env vars > .env.<NODE_ENV>.local > .env.local > .env.<NODE_ENV> > .env
# Empty values (KEY=) mean "not set" and fall back to the default.
# =============================================================================

# --- Runtime & HTTP ----------------------------------------------------------
NODE_ENV=development                # development | production | test
APP_NAME=room-management-api
# APP_VERSION=                      # defaults to package.json version
# HOST=                             # bind address; empty = dual-stack ("::" when IPv6 is available)
PORT=3000
API_PREFIX=api                      # URI versioning appends /v1 -> routes live under /api/v1/...
API_DEFAULT_VERSION=1
# Comma-separated. Supports exact origins, "*.domain.com" (https subdomains) and /regex/.
# "*" is rejected when NODE_ENV=production.
ALLOWED_ORIGINS=*
# Express "trust proxy": false | true | <hop count> | subnet list. Behind one K8s ingress / PaaS router: 1
TRUST_PROXY=false
# LOG_LEVEL=info                    # fatal | error | warn | info | debug | trace (default: info in production, debug otherwise)
# LOG_PRETTY=true                   # default: true in development, NDJSON otherwise
HTTP_REQUEST_TIMEOUT_MS=15000       # default per-request timeout (override per route with @SetRequestTimeout)
HTTP_BODY_LIMIT=1mb
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000    # must exceed the load balancer idle timeout (AWS ALB: 60s)
HTTP_HEADERS_TIMEOUT_MS=66000       # must exceed HTTP_KEEP_ALIVE_TIMEOUT_MS

# --- API governance ----------------------------------------------------------
# SWAGGER_ENABLED=true              # default: enabled outside production
SWAGGER_PATH=api/docs               # /api/docs, /api/docs/admin, /api/docs/guard, /api/docs/external (JSON: <path>-json)
I18N_DEFAULT_LOCALE=vi              # vi | en | ja | ko (Accept-Language / ?lang= override per request)
# Baseline feature flags (runtime overrides are stored in Redis and shared by all pods)
# FEATURE_FLAGS={"evn_tiered_quota":{"enabled":true},"e_invoice_auto_dispatch":{"enabled":true,"allowedTenantIds":["<building-uuid>"]}}
FEATURE_FLAG_CACHE_TTL_MS=10000

# --- Graceful shutdown (SHUTDOWN_TIMEOUT_MS < terminationGracePeriodSeconds) --
SHUTDOWN_DRAIN_DELAY_MS=5000        # set 0 for local development
SHUTDOWN_HOOK_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=25000

# =============================================================================
# PostgreSQL (TypeORM)
# DATABASE_URL takes precedence over DB_MASTER_*.
# DB_IP_FAMILY: 0 = auto (happy eyeballs) | 4 = IPv4 only | 6 = IPv6 only (also accepts auto/ipv4/ipv6)
# =============================================================================

# ---- Profile A: local PostgreSQL installed on the machine (e.g. Windows service postgresql-x64-17),
#      reached over the IPv6 loopback
DB_MASTER_HOST=::1
DB_MASTER_PORT=5432
DB_MASTER_USER=postgres
DB_MASTER_PASSWORD=change-me        # [SECRET]
DB_NAME=room_management
DB_IP_FAMILY=6
# DB_SSL_MODE=disable

# ---- Profile A2: PostgreSQL in Docker (docker compose --profile postgres up -d)
# DB_MASTER_HOST=localhost
# DB_MASTER_PORT=5433
# DB_MASTER_PASSWORD=postgres
# DB_IP_FAMILY=0
#   Least-privilege role created by docker/postgres/init (Row-Level Security is enforced for it):
#   DB_MASTER_USER=app_user  DB_MASTER_PASSWORD=app_user  (run migrations as postgres)

# ---- Profile B: Supabase (online). Project Settings > Database > Connection string.
#   IPv4 networks (Render, Railway, Vercel, most VPS / K8s): Supavisor SESSION pooler - IPv4-only
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_IP_FAMILY=4
#   Serverless / very high concurrency: TRANSACTION pooler on :6543 (detected automatically; session-level
#   startup parameters such as statement_timeout are not sent - set them on the role instead:
#   ALTER ROLE postgres SET statement_timeout = '15s';)
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#   IPv6 networks: DIRECT connection - IPv6-only unless the paid IPv4 add-on is enabled
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# DB_IP_FAMILY=6
#   Full certificate verification (download the CA from Database > SSL Configuration):
# DB_SSL_MODE=verify-full
# DB_SSL_CA=./certs/prod-ca-2021.crt  # path or inline PEM ("\n" escapes allowed)

# TLS: disable | prefer | require | verify-ca | verify-full
# (empty = sslmode from DATABASE_URL, otherwise "require" for Supabase hosts and "disable" elsewhere)
DB_SSL_MODE=
DB_SSL_CA=
# session | transaction (empty = auto-detect: Supabase/PgBouncer port 6543 => transaction)
DB_POOL_MODE=
DB_SCHEMA=public
DB_APPLICATION_NAME=room-management-api

# Optional read replica (empty = reads and writes go to the master through a single pool)
DATABASE_REPLICA_URL=
DB_REPLICA_HOST=
DB_REPLICA_PORT=5432
DB_REPLICA_USER=
DB_REPLICA_PASSWORD=                # [SECRET]

# Pool & timeouts
DB_POOL_MAX=20                      # Supabase free tier: keep total connections across pods within the plan limit
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_MAX_LIFETIME_SECONDS=0           # recycle connections periodically (0 = never)
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=                 # optional, e.g. 5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=  # default: 2 x DB_STATEMENT_TIMEOUT_MS
DB_SLOW_QUERY_MS=500
DB_RETRY_ATTEMPTS=                  # default: 10 in production, 3 otherwise
DB_RETRY_DELAY_MS=3000
DB_LOG_QUERIES=false
DB_MIGRATIONS_RUN=false             # local convenience only - forbidden in production (use the migration Job)
DB_RLS_ROLE_CHECK=warn              # off | warn | error: superuser / BYPASSRLS roles silently disable tenant RLS

# =============================================================================
# Redis (cache, distributed locks, rate limiting, idempotency, permission cache, BullMQ, Socket.IO)
# Mandatory in production.
# =============================================================================
REDIS_ENABLED=true

# ---- Profile A: local Docker Redis (docker compose up -d)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=                     # [SECRET]
REDIS_DB=0
REDIS_TLS=false

# ---- Profile B: managed Redis online. REDIS_URL takes precedence; rediss:// enables TLS (with SNI)
#   Upstash:      rediss://default:<password>@<name>.upstash.io:6379
#   Redis Cloud:  rediss://default:<password>@redis-<port>.<region>.redns.redis-cloud.com:<port>
#   Aiven:        rediss://default:<password>@<service>.aivencloud.com:<port>
# REDIS_URL=                        # [SECRET]
REDIS_TLS_REJECT_UNAUTHORIZED=true
REDIS_TLS_CA=                       # path or inline PEM for private CAs (AWS ElastiCache, self-hosted)
REDIS_FAMILY=0                      # 6 = IPv6-only networks (e.g. Upstash over Fly.io private networking)

# ---- Profile C: self-hosted high availability with Sentinel
REDIS_MODE=standalone               # standalone | sentinel
# REDIS_SENTINELS=10.0.0.11:26379,10.0.0.12:26379,10.0.0.13:26379
# REDIS_SENTINEL_NAME=mymaster
# REDIS_SENTINEL_PASSWORD=          # [SECRET]

REDIS_KEY_PREFIX=rma:               # namespace when several apps share one Redis
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000       # 0 = disabled (never applied to BullMQ blocking connections)

# =============================================================================
# Security
# =============================================================================
# Field-level encryption (AES-256-GCM). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=                     # [SECRET] 64 hex chars
ENCRYPTION_KEY_VERSION=v1
# HMAC pepper for blind indexes on encrypted columns (tenants.id_card_hash). >= 32 chars, different from ENCRYPTION_KEY.
# Never rotate casually: changing it breaks exact lookups until every *_hash column is recomputed.
BLIND_INDEX_PEPPER=                 # [SECRET]
# Previous keys kept for decrypting old rows after rotation: "v0:<64hex>,v-1:<64hex>"
ENCRYPTION_LEGACY_KEYS=             # [SECRET]

# JWT access tokens. HS256/384/512 use JWT_SECRET; RS256/384/512 and ES256/384 verify with JWT_PUBLIC_KEY
JWT_ALGORITHM=HS256
JWT_SECRET=                         # [SECRET] >= 32 chars (HMAC algorithms)
JWT_PUBLIC_KEY=                     # path or inline PEM (RSA / ECDSA)
JWT_PRIVATE_KEY=                    # [SECRET] only needed by the service that issues tokens
JWT_ISSUER=                         # e.g. https://auth.rental.vn (verified when set)
JWT_AUDIENCE=                       # e.g. room-management-api (verified when set)
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=                 # [SECRET] >= 32 chars, must differ from JWT_SECRET in production
JWT_REFRESH_EXPIRES_IN=7d
JWT_CLOCK_TOLERANCE_SEC=5

# Rate limiting (window shared by all tiers; per user when authenticated, per IP otherwise)
THROTTLE_TTL=60000                  # ms
THROTTLE_LIMIT=60                   # public tier (default for every route)
THROTTLE_SEARCH_LIMIT=100           # @ThrottleSearch()
THROTTLE_SENSITIVE_LIMIT=5          # @ThrottleSensitive()

WEBHOOK_TOLERANCE_SECONDS=300       # max clock skew accepted on signed webhook ingress (replay protection)

# =============================================================================
# Observability
# =============================================================================
HEALTH_HEAP_LIMIT_MB=1024           # liveness
HEALTH_RSS_LIMIT_MB=1536            # readiness
HEALTH_DISK_PATH=                   # default: "/" (C:\ on Windows)
HEALTH_DISK_THRESHOLD_PERCENT=0.95

METRICS_ENABLED=true                # Prometheus scrape endpoint at /metrics
METRICS_BEARER_TOKEN=               # [SECRET] require "Authorization: Bearer <token>" when /metrics is internet-facing

# OpenTelemetry tracing (OTLP/HTTP). Local Jaeger: docker compose --profile observability up -d
OTEL_ENABLED=false
OTEL_SERVICE_NAME=                  # default: APP_NAME
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=         # [SECRET] e.g. x-honeycomb-team=<key>,x-honeycomb-dataset=api
OTEL_TRACES_SAMPLER_RATIO=1         # 0..1 (e.g. 0.1 in production); upstream sampling decisions are honoured

# =============================================================================
# Integration & infrastructure
# =============================================================================
# Resilience defaults (overridable per partner call)
CIRCUIT_BREAKER_TIMEOUT_MS=8000
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
CIRCUIT_BREAKER_ERROR_THRESHOLD_PERCENT=50
CIRCUIT_BREAKER_VOLUME_THRESHOLD=5
BULKHEAD_MAX_CONCURRENT=20
BULKHEAD_MAX_QUEUE=10

# Outbound HTTP client (e-invoice gateways, Zalo ZNS, VietQR banks)
HTTP_CLIENT_TIMEOUT_MS=15000
HTTP_CLIENT_MAX_RETRIES=3

# Queue (BullMQ, shares the Redis connection settings; requires maxmemory-policy noeviction)
QUEUE_PREFIX=rma:bull
QUEUE_DEFAULT_ATTEMPTS=5
QUEUE_BACKOFF_DELAY_MS=2000
QUEUE_WORKER_CONCURRENCY=5

# Multi-tier cache
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MEMORY_MAX_ENTRIES=5000       # in-process LRU (fallback when Redis is unavailable + optional L1)
CACHE_L1_TTL_SECONDS=0              # near-cache per pod (0 = disabled)
CACHE_XFETCH_BETA=1

# Distributed locks
LOCK_DEFAULT_TTL_MS=10000
LOCK_RETRY_COUNT=10
LOCK_RETRY_DELAY_MS=200
LOCK_MAX_RETRY_DELAY_MS=2000

# Transactional outbox
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=3000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5
OUTBOX_BASE_RETRY_DELAY_MS=2000
OUTBOX_LEASE_MS=60000
OUTBOX_RETENTION_DAYS=7
OUTBOX_CLEANUP_CRON=0 3 * * *

# Audit trail
AUDIT_HTTP_ENABLED=true             # record every POST/PUT/PATCH/DELETE (disable per route with @SkipAudit)
AUDIT_TIERING_ENABLED=false         # requires STORAGE_ENABLED=true
AUDIT_HOT_RETENTION_DAYS=90
AUDIT_TIERING_CRON=0 2 * * *
AUDIT_TIERING_BATCH_SIZE=1000

# Object storage: AWS S3 | MinIO | Supabase Storage (S3 protocol)
STORAGE_ENABLED=false
STORAGE_ENDPOINT=                   # empty = AWS; MinIO: http://localhost:9000; Supabase: https://<project-ref>.supabase.co/storage/v1/s3
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=room-management
STORAGE_COLD_BUCKET=                # archives (audit tiering); default: STORAGE_BUCKET
STORAGE_ACCESS_KEY=                 # [SECRET] empty on AWS = IAM role (IRSA)
STORAGE_SECRET_KEY=                 # [SECRET]
STORAGE_FORCE_PATH_STYLE=false      # true for MinIO and Supabase Storage
STORAGE_PUBLIC_BASE_URL=            # CDN for public objects
STORAGE_UPLOAD_URL_TTL_SECONDS=900
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
STORAGE_MAX_UPLOAD_BYTES=10485760

# Notifications (a channel stays disabled until its provider is configured)
# NOTIFICATION_DRY_RUN=true         # default: true outside production (log only, recipients masked)
MAIL_FROM=Room Management <no-reply@room-management.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                   # true for SMTPS (465)
SMTP_USER=
SMTP_PASSWORD=                      # [SECRET]
TELEGRAM_BOT_TOKEN=                 # [SECRET]
TELEGRAM_DEFAULT_CHAT_ID=
ZALO_OA_ACCESS_TOKEN=               # [SECRET]
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                  # [SECRET]
TWILIO_FROM_NUMBER=

# WebSocket (Socket.IO, Redis adapter for multi-pod broadcasting)
WS_ENABLED=true

# Webhook egress (reliable dispatch through the webhook-dispatch queue)
WEBHOOK_DISPATCH_TIMEOUT_MS=10000
WEBHOOK_DISPATCH_MAX_ATTEMPTS=8

# PDF rendering: TTF font with Vietnamese glyphs (e.g. NotoSans-Regular.ttf); empty = Helvetica without diacritics
PDF_FONT_PATH=
PDF_FONT_BOLD_PATH=

# =============================================================================
# Rental business & Vietnam statutory compliance (defaults follow the 2026 regulations)
# =============================================================================
# 2026 rental tax: exempt up to 1,000,000,000 VND/year; 5% VAT on taxable revenue, 5% PIT on the excess
# (use 100000000 only to re-run pre-2026 historical periods)
TAX_EXEMPT_THRESHOLD_VND=1000000000
TAX_VAT_RATE_PERCENT=5
TAX_PIT_RATE_PERCENT=5

# EVN residential tariff, tiers 1..6 in VND/kWh before VAT (Decision 1279/QD-BCT, 2025). Update when MOIT revises prices.
EVN_TIER_PRICES_VND=1984,2050,2380,2998,3350,3460
EVN_VAT_RATE_PERCENT=8
EVN_HOUSEHOLD_QUOTA_HEADCOUNT=4     # registered residents per full household quota (1 person = 25% of each tier)

# Billing cycle
BILLING_CYCLE_DAY=28                # monthly invoice run (cron runs 00:00 Asia/Ho_Chi_Minh on this day)
BILLING_PAYMENT_DUE_DAYS=5
DEPOSIT_MONTHS=1                    # standard security deposit (Civil Code 2015, Art. 328)
